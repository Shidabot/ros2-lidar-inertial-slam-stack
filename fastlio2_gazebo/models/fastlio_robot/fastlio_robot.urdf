<?xml version="1.0"?>
<robot name="fastlio_robot">

  <!-- ==================== base（无惯性！） ==================== -->
  <link name="base_footprint"/>

  <!-- ==================== body ==================== -->
  <link name="body">
    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.68 0.42 0.20"/>
      </geometry>
      <material name="red">
        <color rgba="0.85 0.15 0.15 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.68 0.42 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="12"/>
      <origin xyz="0 0 0.11"/>
      <inertia 
        ixx="1.0" ixy="0.0" ixz="0.0"
        iyy="1.6" iyz="0.0"
        izz="2.0"/>
    </inertial>
  </link>

  <joint name="base_to_body" type="fixed">
    <parent link="base_footprint"/>
    <child link="body"/>
  </joint>

  <!-- ==================== 轮子（统一正确 inertial） ==================== -->

  <!-- 左后 -->
  <link name="left_rear_wheel">
    <visual>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0"/>
      <inertia 
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.23 0.23 0.105" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>
  </joint>

  <!-- 右后 -->
  <link name="right_rear_wheel">
    <visual>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0"/>
      <inertia 
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.23 -0.23 0.105" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>
  </joint>

  <!-- 左前 -->
  <link name="left_front_wheel">
    <visual>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0"/>
      <inertia 
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.23 0.23 0.105" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- 右前 -->
  <link name="right_front_wheel">
    <visual>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.105" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0"/>
      <inertia 
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="body"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.23 -0.23 0.105" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- ==================== 摩擦 ==================== -->
  <gazebo reference="left_rear_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="right_rear_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="left_front_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_front_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- ==================== IMU（无错误版本） ==================== -->
  <gazebo reference="body">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/livox/imu</remapping>
        </ros>
        <frameName>body</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== LiDAR ==================== -->
  <gazebo reference="body">
    <sensor type="ray" name="lidar">
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>

          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>   <!-- ⭐ 你之前缺这个 -->
            <min_angle>-0.35</min_angle>
            <max_angle>0.35</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>30.0</max>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/livox/lidar</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>body</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== diff_drive（ROS2 版本） ==================== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>

      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <wheel_separation>0.46</wheel_separation>
      <wheel_diameter>0.21</wheel_diameter>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

      <max_wheel_torque>20</max_wheel_torque>
      
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>